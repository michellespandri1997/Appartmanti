        "image": "https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1100&q=85",
    },
}
CHANNEL_FEES = {"Booking.com": 0.15, "Airbnb": 0.14, "Diretto": 0.0}


def shift_month(value: date, offset: int) -> date:
    month_index = value.year * 12 + value.month - 1 + offset
    year, month = divmod(month_index, 12)
    return date(year, month + 1, 1)


def make_demo_bookings() -> pd.DataFrame:
    rng = random.Random(218)
    names = ["Giulia R.", "Marco B.", "Elena C.", "Luca F.", "Sara M.", "Andrea P.", "Nadia T.", "Paolo G."]
    channels = ["Booking.com", "Booking.com", "Booking.com", "Airbnb", "Airbnb", "Diretto"]
    records: list[dict] = []
    first_month = shift_month(TODAY.replace(day=1), -18)
    last_month = shift_month(TODAY.replace(day=1), 4)
    booking_number = 1001

    for property_name, details in PROPERTIES.items():
        month_start = first_month
        while month_start <= last_month:
            month_end = shift_month(month_start, 1)
            arrival = month_start + timedelta(days=rng.randint(0, 5))
            while arrival < month_end:
                nights = rng.randint(2, 5)
                departure = arrival + timedelta(days=nights)
                if departure > TODAY:
                    status = "Confermata"
                    if arrival <= TODAY:
                        status = "In soggiorno"
                else:
                    status = "Completata"
                if rng.random() < (0.07 if departure <= TODAY else 0.035):
                    status = "Annullata"

                month = arrival.month
                seasonal_factor = 1.22 if month in (4, 5, 6, 9, 10) else 1.32 if month in (2, 12) else 0.91 if month in (1, 7, 8) else 1.0
                nightly_rate = round(details["tariffa"] * seasonal_factor * rng.uniform(0.88, 1.16))
                channel = rng.choice(channels)
                gross = nightly_rate * nights
                records.append(
                    {
                        "Codice": f"MI-{booking_number}",
                        "Appartamento": property_name,
                        "Ospite": rng.choice(names),
                        "Check-in": arrival,
                        "Check-out": departure,
                        "Notti": nights,
                        "Ospiti": rng.randint(1, details["ospiti"]),
                        "Canale": channel,
                        "Stato": status,
                        "Tariffa/notte": nightly_rate,
                        "Importo": gross,
                        "Commissione": round(gross * CHANNEL_FEES[channel]),
                    }
                )
                booking_number += 1
                arrival += timedelta(days=nights + rng.randint(2, 7))
            month_start = month_end

    return pd.DataFrame(records)


def get_bookings() -> pd.DataFrame:
    if "extra_bookings" not in st.session_state:
        st.session_state.extra_bookings = []
    bookings = pd.concat(
        [make_demo_bookings(), pd.DataFrame(st.session_state.extra_bookings)],
        ignore_index=True,
    )
    for column in ("Check-in", "Check-out"):
        bookings[column] = pd.to_datetime(bookings[column]).dt.date
    return bookings


def nights_in_period(row: pd.Series, period_start: date, period_end: date) -> int:
    start = max(row["Check-in"], period_start)
    end = min(row["Check-out"], period_end)
    return max(0, (end - start).days)


def monthly_performance(bookings: pd.DataFrame, property_names: list[str]) -> pd.DataFrame:
    active = bookings[
        bookings["Appartamento"].isin(property_names) & bookings["Stato"].ne("Annullata")
    ]
    months = [shift_month(TODAY.replace(day=1), offset) for offset in range(-11, 3)]
    rows = []
    for month_start in months:
        month_end = shift_month(month_start, 1)
        available_nights = (month_end - month_start).days * len(property_names)
        booked_nights = sum(nights_in_period(row, month_start, month_end) for _, row in active.iterrows())
        revenue = sum(
            nights_in_period(row, month_start, month_end) * row["Tariffa/notte"]
            for _, row in active.iterrows()
        )
        rows.append(
            {
                "Mese": month_start,
                "Occupazione": round(100 * booked_nights / available_nights, 1) if available_nights else 0,
                "Ricavi lordi": revenue,
            }
        )
    return pd.DataFrame(rows)


def euro(value: float | int) -> str:
    return f"€ {value:,.0f}".replace(",", ".")


def add_booking(bookings: pd.DataFrame) -> None:
    with st.form("new_booking", clear_on_submit=True):
        left, right = st.columns(2)
        with left:
            property_name = st.selectbox("Appartamento", list(PROPERTIES))
            guest = st.text_input("Nome ospite")
            check_in = st.date_input("Check-in", value=TODAY + timedelta(days=14))
            channel = st.selectbox("Canale", list(CHANNEL_FEES))
        with right:
            guests = st.number_input("Numero ospiti", min_value=1, max_value=4, value=2)
            check_out = st.date_input("Check-out", value=TODAY + timedelta(days=17))
            nightly_rate = st.number_input(
                "Tariffa a notte (€)", min_value=40, max_value=1500,
                value=PROPERTIES[property_name]["tariffa"], step=5,
            )
        submitted = st.form_submit_button("Aggiungi prenotazione", type="primary", icon=":material/add:")

    if submitted:
        if not guest.strip():
            st.error("Inserisci il nome dell'ospite.")
        elif check_out <= check_in:
            st.error("Il check-out deve essere successivo al check-in.")
        elif guests > PROPERTIES[property_name]["ospiti"]:
            st.error(f"{property_name} può ospitare al massimo {PROPERTIES[property_name]['ospiti']} persone.")
        else:
            nights = (check_out - check_in).days
            gross = int(nightly_rate) * nights
            st.session_state.extra_bookings.append(
                {
                    "Codice": f"MI-N{len(bookings) + 1}",
                    "Appartamento": property_name,
                    "Ospite": guest.strip(),
                    "Check-in": check_in,
                    "Check-out": check_out,
                    "Notti": nights,
                    "Ospiti": int(guests),
                    "Canale": channel,
                    "Stato": "Confermata",
                    "Tariffa/notte": int(nightly_rate),
                    "Importo": gross,
                    "Commissione": round(gross * CHANNEL_FEES[channel]),
                }
            )
            st.toast("Prenotazione aggiunta alla demo", icon=":material/check_circle:")
            st.rerun()


bookings = get_bookings()

with st.sidebar:
