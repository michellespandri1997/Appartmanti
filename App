TODAY = date.today()
PROPERTIES = {
    "Brera Loft": {
        "zona": "Brera · Milano centro",
        "ospiti": 4,
        "tariffa": 178,
        "image": "https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1100&q=85",
    },
    "Navigli Studio": {
        "zona": "Navigli · Darsena",
        "ospiti": 2,
