future_end = TODAY + timedelta(days=30)
upcoming_nights = sum(nights_in_period(row, TODAY, future_end) for _, row in active.iterrows())
available_next_month = 30 * len(selected_properties)
occupancy_next_month = 100 * upcoming_nights / available_next_month if available_next_month else 0
revenue_next_month = sum(
    nights_in_period(row, TODAY, future_end) * row["Tariffa/notte"] for _, row in active.iterrows()
)
arrivals_week = int(
    (
        filtered["Check-in"].between(TODAY, TODAY + timedelta(days=7))
        & filtered["Stato"].ne("Annullata")
    ).sum()
)
historical = active[
